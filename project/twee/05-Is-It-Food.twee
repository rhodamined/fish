:: 05-Eating
<<set $status to 'eating'>>\
<<set $size to $size + 1>>\
<<include "06-Your-Fish">>\

<<script>>
(function generate() {

  let sourceTaste = {
    "origin": "It was #description# to eat.",
    "description": ["delicious", "terrible", "exquisite", "an ordeal", "heart-wrenching", "so quick", "slippery", "dissatisfying"]
  }
  let grammar = tracery.createGrammar(sourceTaste);
  // grammar.addModifiers(tracery.baseEngModifiers);
  let taste = grammar.flatten("#origin#");

  State.variables.taste = taste;

})();
<</script>>\
\
$taste

<<updateWidget>>\
<<link "I'm still hungry.">>\
  <<needFood>>
<</link>>\

:: 05-Not-Eating
<<set $status to 'not eating'>>
<<include "06-Your-Fish">>\

<<updateWidget>>\
<<link "I'm so so hungry.">>\
  <<needFood>>
<</link>>\
